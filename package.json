{
  "name": "allium-assault",
  "version": "1.73.0",
  "description": "Turn-based 3D artillery game with garlic buddies, in the spirit of Worms Armageddon. Runs in the browser.",
  "private": true,
  "type": "module",
  "author": "Marcel Petrick <mail@marcelpetrick.it>",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && prettier --check . && stylelint \"src/**/*.css\" && markdownlint-cli2 \"**/*.md\" && npm run lint:spdx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run coverage && npm run build && npm run e2e",
    "lint:spdx": "node scripts/spdx.mjs",
    "spdx:fix": "node scripts/spdx.mjs --fix",
    "lint:reuse": "uvx reuse lint",
    "format": "prettier --write . && stylelint \"src/**/*.css\" --fix && markdownlint-cli2 --fix \"**/*.md\"",
    "capture-media": "node scripts/capture-media.mjs",
    "profile": "vitest run --config vitest.profile.config.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.27.1",
    "simplex-noise": "4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.8",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "smol-toml": "1.8.0"
  }
}
